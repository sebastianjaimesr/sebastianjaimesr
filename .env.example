# Public URL where the site is deployed (no trailing slash).
# When set, canonical, og:url and absolute og:image tags are generated.
# Example: VITE_SITE_URL=https://sebastianjaimesr.github.io/sebastian-portfolio
VITE_SITE_URL=

# Base path for the build. Use "/" for a custom domain or a user site
# (https://<user>.github.io), or "/<repo-name>/" for a GitHub Pages project site.
BASE_PATH=/
